# Microsoft Entra SPA application client ID used by the OneDrive web login.
# Register the redirect URLs for the web deployment and the Electron preview URL
# (http://127.0.0.1:45217/) in the SPA platform of the same application.
VITE_ONEDRIVE_CLIENT_ID=

# Optional. Defaults to the Microsoft personal-account authority.
VITE_ONEDRIVE_AUTHORITY=https://login.microsoftonline.com/consumers/oauth2/v2.0
