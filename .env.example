# Optional override for the public Microsoft Entra SPA client ID used by the
# OneDrive web login. Official builds already include the app's public client ID.
# Register the redirect URLs for the web deployment and Electron preview URL
# (http://localhost:45217/) in the SPA platform of the same application.
VITE_ONEDRIVE_CLIENT_ID=

# Optional. Defaults to the Microsoft personal-account authority.
VITE_ONEDRIVE_AUTHORITY=https://login.microsoftonline.com/consumers/oauth2/v2.0
